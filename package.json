{
  "name": "kitdev-space",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "description": "Developer tools that run in the browser. Convert, inspect, and clean data without an upload.",
  "author": "Hamed Niroomand",
  "license": "MIT",
  "homepage": "https://kitdev.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/kitdev-space.git"
  },
  "bugs": {
    "url": "https://github.com/hamedniroomand/kitdev-space/issues"
  },
  "keywords": [
    "developer-tools",
    "nuxt",
    "bun",
    "json",
    "sqlite",
    "exif",
    "privacy"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "bun --bun nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run && bun test tests/bun",
    "test:watch": "vitest",
    "test:bun": "bun test tests/bun",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:run": "playwright test",
    "prepare": "husky"
