{
  "name": "devkit-space",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "bun --bun nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run && bun test tests/bun",
    "test:watch": "vitest",
    "test:bun": "bun test tests/bun",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/simple-icons": "^1.2.94",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.8",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/seo": "5.3.14",
    "@takumi-rs/core": "^2.13.5",
    "@vueuse/nuxt": "14.4.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,vue}": "bun lint --fix"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.2"
}
