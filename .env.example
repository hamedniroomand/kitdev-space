# Optional OG image secret for @nuxtjs/seo
# NUXT_OG_IMAGE_SECRET=

# Umami analytics. Leave the website ID empty to keep the tracker off.
# Read at build time, so a change needs a redeploy.
NUXT_PUBLIC_SCRIPTS_UMAMI_ANALYTICS_WEBSITE_ID=
# Self-hosted Umami origin only. Empty means Umami Cloud.
NUXT_PUBLIC_UMAMI_HOST_URL=
